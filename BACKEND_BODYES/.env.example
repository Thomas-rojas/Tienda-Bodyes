PORT=4000
NODE_ENV=development

# App URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# Supabase (secret solo en backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_ANON_KEY=sb_publishable_xxx

# Mercado Pago — usa claves de PRUEBA primero (TEST-...)
# Panel: https://www.mercadopago.com.co/developers/panel
MERCADOPAGO_ENV=test
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Si no hay Access Token en development, el backend simula el pago en /pago/simular
# SIMULATE_PAYMENTS=true

# ---------------------------------------------------------------------------
# Correo (elige UNA opción: Resend O SMTP Gmail)
# Se envía solo cuando el pago está confirmado (paid): cliente + STORE_EMAIL
# ---------------------------------------------------------------------------
STORE_EMAIL=pedidos@tudominio.com

# Opción A — Resend (https://resend.com/api-keys)
RESEND_API_KEY=
EMAIL_FROM=CLIO <onboarding@resend.dev>
# Con dominio verificado: EMAIL_FROM=CLIO <noreply@tudominio.com>

# Opción B — Gmail SMTP (contraseña de aplicación, no la clave normal)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Si usas Gmail: EMAIL_FROM=CLIO <tu-correo@gmail.com>

# WhatsApp Cloud API — https://developers.facebook.com
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
