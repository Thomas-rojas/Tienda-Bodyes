PORT=4000
NODE_ENV=development

# App URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# Supabase (secret solo en backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_ANON_KEY=sb_publishable_xxx

# Wompi — usa claves de PRUEBA primero (pub_test_ / prv_test_)
# Dashboard: https://comercios.wompi.co
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
# WOMPI_API_BASE=https://sandbox.wompi.co/v1

# Si no hay claves Wompi en development, el backend simula el pago en /pago/simular
# SIMULATE_PAYMENTS=true

# Correo (Resend) — https://resend.com
RESEND_API_KEY=
EMAIL_FROM=CLIO <onboarding@resend.dev>

# WhatsApp Cloud API — https://developers.facebook.com
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
